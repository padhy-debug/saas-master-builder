# ========================================================================
# SAAS MASTER BUILDER - COMPREHENSIVE ENVIRONMENT VARIABLES (.env.example)
# All sensitive variables must be populated before running in production.
# ========================================================================

# --- Node & Application Environment ---
NODE_ENV=development
PORT=3000
APP_NAME="NextGen SaaS Platform"
APP_URL=http://localhost:3000

# --- Primary PostgreSQL Database (Multi-Tenant RLS Enabled) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_master_db?sslmode=disable"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/saas_master_db" # Bypass connection pool for migrations
DB_POOL_MAX=20
DB_TIMEOUT_MS=5000

# --- Distributed Redis (Rate Limiting, Sessions, Semantic Caching) ---
REDIS_URL="redis://localhost:6379"
REDIS_TOKEN="" # Required for Upstash Redis

# --- Authentication & JWT Secrets ---
JWT_SECRET="replace_with_a_secure_high_entropy_256_bit_secret_string"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_EXPIRES_IN="30d"

# --- Stripe Payments & Webhooks ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_ENTERPRISE_PRICE_ID="price_..."

# --- Cryptographic Asymmetric Licensing (Ed25519) ---
LICENSE_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
LICENSE_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# --- Enterprise Identity (SAML 2.0 & SCIM) ---
SAML_ENTRY_POINT="https://login.microsoftonline.com/.../saml2"
SAML_ISSUER="https://app.yourdomain.com/auth/saml/metadata"
SAML_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
SCIM_BEARER_SECRET="scim_sec_..."

# --- Direct-to-Storage Object Storage (AWS S3 / Cloudflare R2) ---
STORAGE_PROVIDER="s3" # 's3' or 'r2'
S3_BUCKET_NAME="saas-master-storage-prod"
S3_REGION="us-east-1"
S3_ENDPOINT="https://s3.amazonaws.com"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."

# --- Transactional Email & Notifications (Resend / SendGrid / Postmark) ---
EMAIL_PROVIDER="resend" # 'resend' | 'postmark' | 'sendgrid' | 'smtp'
EMAIL_API_KEY="re_..."
EMAIL_FROM="notifications@yourdomain.com"
EMAIL_REPLY_TO="support@yourdomain.com"

# --- AI SaaS Gateway (Optional) ---
AI_PROVIDER="gemini" # 'gemini' | 'anthropic' | 'openai'
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
MAX_TENANT_TOKENS_PER_DAY=100000

# --- Error Tracking & Observability ---
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
LOG_LEVEL="info" # 'trace' | 'debug' | 'info' | 'warn' | 'error'
